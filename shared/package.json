{
  "name": "@project/shared",
  "version": "0.0.0",
  "description": "Shared zod schemas for the project",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./schema": {
      "import": "./dist/schema.js",
      "types": "./dist/schema.d.ts"
    },
    "./enums": {
      "import": "./dist/enums.js",
      "types": "./dist/enums.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./mutator": {
      "import": "./dist/mutator.js",
      "types": "./dist/mutator.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "nodemon",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ./src",
    "migrate:generate": "node dist/cli/migrate.js generate",
    "migrate:status": "node dist/cli/migrate.js status"
  },
  "bin": {
    "migrate": "./dist/cli/migrate.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/parser": "^7.28.5",
    "@types/node": "^22.14.1",
    "diff": "^8.0.2",
    "fast-check": "^4.3.0",
    "nodemon": "^3.1.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.1",
    "pocketbase": "^0.26.0",
    "zod": "^3.24.3"
  }
}

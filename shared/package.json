{
  "name": "@project/shared",
  "version": "0.0.0",
  "description": "Shared zod schemas for the project",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./schema": {
      "import": "./dist/schema.js",
      "types": "./dist/schema.d.ts"
    },
    "./enums": {
      "import": "./dist/enums.js",
      "types": "./dist/enums.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./mutator": {
      "import": "./dist/mutator.js",
      "types": "./dist/mutator.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "nodemon",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ./src",
    "migrate:generate": "npx pocketbase-migrate generate",
    "migrate:status": "npx pocketbase-migrate status",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/parser": "^7.28.5",
    "@types/node": "^22.19.3",
    "diff": "^8.0.2",
    "fast-check": "^4.4.0",
    "nodemon": "^3.1.11",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "pocketbase": "^0.26.5",
    "pocketbase-zod-schema": "^0.2.3",
    "zod": "^3.25.76"
  }
}
